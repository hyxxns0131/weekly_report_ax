# weekly_report 환경 변수 예시 (값은 비워 두고 커밋한다)
# 실제 값은 같은 폴더의 .env 에 넣는다. .env 는 절대 커밋하지 않는다. (이 저장소는 공개 저장소다)
# 기준: SAMC 기존 도구(customs_bot) .env.example + 팀 결정(Next.js + FastAPI, Claude/GPT, Supabase 공개 정보만)
# 작성일: 2026-11-24 · 상태: 초안

# ─────────────────────────────────────────────
# 1. 실행 환경
# ─────────────────────────────────────────────
APP_ENV=local                      # local | demo
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000 # Next.js 개발 서버 주소
TZ_NAME=Asia/Seoul                 # 보고 기간(지난주 월~일) 계산 기준 시간대
DATA_DIR=data                      # 로컬 작업 데이터 폴더 (.gitignore)
LOCAL_DB_PATH=data/weekly.db       # 로컬 SQLite (작업 중 수집·선별·매칭 결과, 캐시). 테이블 정의는 PM(KHS)만 관리

# ─────────────────────────────────────────────
# 2. AI (core/llm.py 한 곳에서만 사용)
# ─────────────────────────────────────────────
LLM_ENABLED=true                   # false면 AI 호출 없이 규칙만으로 동작 (선별은 '검토 필요'로 남김)
AI_PROVIDER=openai                 # openai | claude. 화면(각 탭 AI 상태 줄)에서 바꾸면 그 선택이 우선
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                      # 비우면 core/config.py 기본값
OPENAI_API_KEY=                    # sk-… 값은 여기에만. 화면 [연결 검사]로 확인
OPENAI_MODEL=                      # 비우면 core/config.py 기본값
MASK_CUSTOMER_NAMES=true           # LLM으로 보내기 전 고객사명 가리기 (core/masking.py). 끄지 않는다

# ─────────────────────────────────────────────
# 3. 구글 (드라이브 = 실무 기준 저장소, Gmail = 공문·뉴스레터 수신 + 승인 후 발송)
# ─────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json   # OAuth 데스크톱 앱 클라이언트 (커밋 금지)
GOOGLE_TOKEN_FILE=token.json               # 로그인 후 자동 생성 (커밋 금지)
DRIVE_CUSTOMERS_FOLDER_ID=         # 고객사 목록·'원산지-식품유형' 키워드가 있는 폴더
DRIVE_REPORTS_FOLDER_ID=           # 확정된 주간 보고서·발송한 메일 보관 폴더
DRIVE_LAW_FOLDER_ID=               # (선택) 기존 도구 '법령자료 (공유본)' 폴더. 연계 시험용
GMAIL_INBOX_QUERY=                 # 공문·뉴스레터 수신 메일 검색어 (예: from:… label:…). 확인 필요
GMAIL_SENDER=                      # 발송 계정 (회사 구글 비즈니스 계정)
GMAIL_STAFF_TO=                    # 담당자용 주간 요약 수신자 (쉼표로 여러 명)
MAIL_SEND_ENABLED=false            # true여도 담당자 승인한 초안만 발송. 자동 발송 기능은 만들지 않는다

# ─────────────────────────────────────────────
# 4. 공공 데이터 (공개 정보 → Supabase 적재 대상)
# ─────────────────────────────────────────────
LAW_API_OC=                        # 법제처 국가법령정보 OPEN API. 등록한 공인 IP에서만 동작 (PC마다 등록)
DATA_GO_KR_SERVICE_KEY=            # 공공데이터포털 일반 인증키 (Decoding). 사용할 데이터셋 확인 필요
FOODSAFETY_API_KEY=                # 식품안전나라 Open API (오늘의 팁 근거 자료 등, 선택)
COLLECT_USER_AGENT="weekly_report-prototype"   # 사이트 수집 시 User-Agent
COLLECT_DELAY_SEC=2                # 같은 사이트 요청 간격(초)

# ─────────────────────────────────────────────
# 5. Supabase (공개 정보만. 고객사명이 붙은 데이터 금지)
#    프로젝트: weekly-report-ax (서울). 키 확인 위치: Supabase 대시보드 → weekly-report-ax
#    → Project Settings → API Keys. URL은 Project Settings → Data API(또는 General)에 있다.
#    키는 PM(KHS)이 팀원에게 메신저 1:1로 전달한다. 채팅방·이슈·커밋에 붙여 넣지 않는다.
# ─────────────────────────────────────────────
SUPABASE_URL=https://gzvlpbpyyjwbbsfnjvun.supabase.co   # 비밀값 아님. 모두 같은 값
SUPABASE_ANON_KEY=                 # 팀원용: 대시보드의 publishable 키(sb_publishable_…). 읽기 전용(RLS로 SELECT만 허용)
SUPABASE_SERVICE_ROLE_KEY=         # PM(KHS)만: 대시보드의 secret 키(sb_secret_…). 쓰기·적재용. 팀원 .env에는 넣지 않는다

# ─────────────────────────────────────────────
# 6. 로그인 (첫 화면). 값은 .env 에만, 절대 커밋·공유 금지
# ─────────────────────────────────────────────
ADMIN_USERNAME=                    # 관리자 아이디
ADMIN_PASSWORD=                    # 관리자 비밀번호 (12자 이상)
AUTH_SECRET_KEY=                   # 로그인 토큰 서명용 긴 무작위 문자열. PC마다 새로 만든다
AUTH_SESSION_HOURS=12              # 로그인 유지 시간
